{
  // The name of your app. The setup step (and ONBOARDING) renames this to match your project.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-stack-app",
  // The API entry point (the code that runs for /api/* requests).
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-01",
  // Static assets = your built React app. With the Cloudflare Vite plugin, the output directory is
  // filled in automatically, so it is intentionally omitted here.
  "assets": {
    // Unknown paths return index.html so the single-page app can handle its own routing.
    "not_found_handling": "single-page-application",
    // These paths run the Worker; everything else is served straight from static assets. /api/* is
    // the REST API, /mcp is the connector endpoint, and the rest are the OAuth provider's endpoints
    // (the consent page, token + dynamic client registration, and the discovery document).
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/authorize",
      "/token",
      "/register",
      "/.well-known/oauth-authorization-server"
    ]
  },
  // Free request logs in the Cloudflare dashboard — handy when something misbehaves.
  "observability": { "enabled": true },
  // Your database (D1). `database_id` is filled in by setup, after `wrangler d1 create`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibe-stack-app-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // File storage (R2), for photos and uploads. Remove this block if you skip file storage for now.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "vibe-stack-app-files"
    }
  ],
  // Key-value store used by the OAuth provider to hold connector tokens, grants and clients. `id` is
  // filled in by setup, after `wrangler kv namespace create OAUTH_KV` (see the vibe-connector skill).
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_YOUR_KV_ID"
    }
  ]
  // AI models (summarise / translate / parse free text) are optional and OFF by default. The
  // `vibe-ai` skill adds the `{ "ai": { "binding": "AI" } }` binding here and wires an example route;
  // the helper module (src/worker/ai.ts) is already shipped. No API key, no extra account.
  //
  // OWNER_SECRET (the owner's access key) is a Worker SECRET, not listed here. Set it once with
  // `wrangler secret put OWNER_SECRET`. The website, the REST API and the OAuth consent page all
  // check this one value; a request that presents it is treated as the owner.
}
