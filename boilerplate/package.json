{
  "name": "vibe-stack-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fix": "biome check --write .",
    "validate": "biome ci . && npm run build && vitest run",
    "deploy": "npm run validate && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:apply:local": "wrangler d1 migrations apply DB --local",
    "db:apply:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@mantine/charts": "^9.2.0",
    "@mantine/core": "^9.2.0",
    "@mantine/form": "^9.2.0",
    "@mantine/hooks": "^9.2.0",
    "@tabler/icons-react": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "hono": "^4.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.16.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "postcss": "^8.4.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.20.0"
  }
}
